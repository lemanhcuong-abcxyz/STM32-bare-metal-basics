#include "stm32f4xx.h"

void delay(void)
{
    for (volatile int i = 0; i < 500000; i++);
}

int main(void)
{
    // 1. Enable clock cho GPIOA
    RCC->AHB1ENR |= (1 << 0);

    // 2. PA5 -> output
    GPIOA->MODER &= ~(3 << (5 * 2));
    GPIOA->MODER |=  (1 << (5 * 2));

    while (1)
    {
        // 3. Toggle PA5
        GPIOA->ODR ^= (1 << 5);

        delay();
    }
}
